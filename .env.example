# ============================================================
# XwOps 平台 —— docker compose 环境变量
#
# 用法：
#   cp .env.example .env
#   然后修改下面两个密码（改完不要再提交）
#
# ★ 这两个密码会被 docker-compose.yml 注入到 MySQL / Redis 容器，
#   同时必须与 backend/conf/env.py 里的 DATABASE_PASSWORD /
#   REDIS_PASSWORD 保持一致，否则后端连不上数据库。
# ============================================================

# MySQL root 密码
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# Redis 密码
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ------------------------------------------------------------
# 告警 Webhook 认证密钥（v1.1.0 起必填）
#
# ★ 平台接收 Alertmanager 告警的接口 /api/alert/webhook/receiver/
#   现在要求 Bearer 认证。这个值会随 compose 注入 django / celery 容器；
#   也可以改为只写在 backend/conf/env.py 里（两者取其一，不必都填）。
#
# ★ 必须与 docker_env/alertmanager/alertmanager.yml 里
#   http_config.authorization.credentials 完全一致，且长度 >= 32 字符。
#   不填的后果：Alertmanager 推来的告警全部被拒（503 未配置 / 401 认证失败），
#   平台侧看不到任何告警。
#
# 生成一个：  python -c "import secrets; print(secrets.token_urlsafe(32))"
# ------------------------------------------------------------
ALERT_WEBHOOK_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM
