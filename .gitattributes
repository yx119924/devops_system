# ==============================================================================
# 换行符统一为 LF
#
# 为什么必须显式声明？
#   本项目在 Windows 上编辑、在 Linux（Docker 容器）里运行。
#   若不声明，Git 可能按平台自动转换，提交进仓库的是 CRLF；
#   Linux 侧 checkout 后 shell 脚本首行变成 `#!/bin/bash\r`，
#   报错 `bad interpreter: No such file or directory`，容器直接起不来，
#   而且这种故障从报错信息上极难联想到换行符。
# ==============================================================================

* text=auto eol=lf

# Shell 脚本与容器入口：必须是 LF，否则容器无法启动
*.sh   text eol=lf
*.bash text eol=lf

# 配置与代码：文本，统一 LF
*.py     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.vue    text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.md     text eol=lf
*.sql    text eol=lf
*.conf   text eol=lf
*.yml    text eol=lf
Dockerfile* text eol=lf

# 二进制文件：禁止任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.bmp   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.tar   binary
*.gz    binary
*.tgz   binary
*.zip   binary
*.7z    binary
*.pdf   binary
*.so    binary
*.pyc   binary
*.pyd   binary
*.db    binary
*.xlsx  binary
*.xls   binary
*.docx  binary
